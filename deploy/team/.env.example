# Copy to .env and fill in. Never commit .env.
OPSLENS_HOST=ops.example.com
# The password your team signs in with (12+ characters). People also type a name, which is shown in the audit log.
OPSLENS_TEAM_PASSWORD=
# A long random string that signs session cookies, so people stay signed in across restarts:  openssl rand -hex 32
OPSLENS_SESSION_SECRET=
# Pin a release for repeatable deploys, e.g. 0.3.0
OPSLENS_VERSION=latest
