    # opslens demo app (sample data only), proxied to the local service. ^~ beats the static-asset regex below.
    location = /app { return 301 /app/; }
    location ^~ /app/ {
        proxy_pass http://127.0.0.1:8077/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite (never append): the app rate-limits on this
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Content-Type-Options;        # the server block already sets these
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Content-Security-Policy;
        proxy_read_timeout 30s;
        client_max_body_size 64k;
        expires off;
    }

